# Python
__pycache__/
*.py[cod]

# Virtual environments
.venv/
venv/
env/

# Local settings with secrets; .env.example is the template
.env
.env.*
!.env.example

# Test, lint and coverage output
.pytest_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Editors and OS files
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db

# TMDb data never enters git: neither the Kaggle CSVs nor the catalogue fetched into
# dataset/refreshed/. The tests fall back to the small fixture CSVs.
**/dataset/**/*.csv
!tests/fixtures/dataset/*.csv
dataset/refreshed/fetched_on.txt
