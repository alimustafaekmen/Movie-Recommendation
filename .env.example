# Copy to .env and fill in. Variables already set in the environment take precedence.

# --- Recommended (the app still starts without them, with the fallbacks noted) ---

# TMDb v3 API key for posters, trailers and person pages (default: unset, dataset only)
# Get one at https://www.themoviedb.org/settings/api
TMDB_API_KEY=
# Signs the flash-message cookie (default: a random key on every start)
# Generate one: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# --- Optional (the values shown are the defaults unless noted) ---

# Folder with tmdb_5000_movies.csv and tmdb_5000_credits.csv
# DATASET_DIR=dataset
# DEBUG, INFO, WARNING or ERROR; another value logs a warning and uses INFO
# LOG_LEVEL=INFO
# 1 when the site is served over HTTPS: Secure session cookie and HSTS (default: off)
# SESSION_COOKIE_SECURE=1

# Dev server (python app.py) only; the Docker image always listens on port 5001
# HOST=127.0.0.1
# PORT=5001
# 1 turns on Flask debug mode (default: off)
# FLASK_DEBUG=1
