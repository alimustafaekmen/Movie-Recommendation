# TMDb v3 API key: https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# generate: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# Optional
# FLASK_DEBUG=1
# HOST=127.0.0.1
# PORT=5001
# LOG_LEVEL=INFO
# Directory with tmdb_5000_movies.csv and tmdb_5000_credits.csv (default: dataset/)
# DATASET_DIR=dataset
# Set to 1 when the site is served over HTTPS
# SESSION_COOKIE_SECURE=1
