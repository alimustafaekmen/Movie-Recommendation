# TMDb v3 API key: https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# generate: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# Optional
# FLASK_DEBUG=1
# HOST=127.0.0.1
# For python app.py; the Docker image always listens on 5001
# PORT=5001
# DEBUG, INFO, WARNING or ERROR; another value logs a warning and uses INFO
# LOG_LEVEL=INFO
# Directory with tmdb_5000_movies.csv and tmdb_5000_credits.csv (default: dataset/)
# DATASET_DIR=dataset
# Set to 1 when the site is served over HTTPS
# SESSION_COOKIE_SECURE=1
